{
  "name": "danielhaus.de",
  "version": "1.10.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://code.d7c.de/danielhaus/danielhaus.de.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "start": "npm run dev",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{js,ts,svelte,html,json,cjs,yaml}": [
      "prettier --write .",
      "eslint ."
    ],
    "*.{css,scss}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26",
    "@vitest/browser-playwright": "^4.1.10",
    "browserslist": "^4.28.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "gl-matrix": "^3.4.4",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.3.0",
    "modern-normalize": "^3.0.1",
    "node-addon-api": "^8.9.1",
    "node-gyp": "^13.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-glsl": "^0.3.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-glsl": "^1.6.1",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^2.2.1"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true
  }
}
